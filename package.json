{
  "name": "wanikani-generator-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "build": "npm --prefix frontend run build",
    "check:backend": "python -m compileall backend/app"
  }
}
